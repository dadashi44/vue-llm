{
  "name": "vue-llm",
  "version": "1.2.0",
  "type": "module",
  "description": "AI SDK for Vue and Nuxt: streaming useChat, tool calling, Generative UI and in-browser WebGPU models for OpenAI, Anthropic, Gemini and Ollama.",
  "keywords": [
    "vue",
    "vue3",
    "ai",
    "llm",
    "chat",
    "streaming",
    "openai",
    "anthropic",
    "gemini",
    "ollama",
    "composable",
    "nuxt",
    "nuxt-module",
    "typescript",
    "sse",
    "gpt",
    "claude",
    "ai-sdk",
    "chatbot",
    "chat-ui",
    "generative-ui",
    "tool-calling",
    "function-calling",
    "webgpu",
    "webllm",
    "in-browser",
    "local-llm",
    "structured-output",
    "vue2",
    "composition-api",
    "llama"
  ],
  "license": "MIT",
  "author": "dadashi44",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dadashi44/vue-llm.git"
  },
  "bugs": "https://github.com/dadashi44/vue-llm/issues",
  "homepage": "https://dadashi44.github.io/vue-llm/",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.js"
    },
    "./providers": {
      "types": "./dist/providers.d.ts",
      "import": "./dist/providers.js",
      "require": "./dist/providers.cjs"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./devtools": {
      "types": "./dist/devtools.d.ts",
      "import": "./dist/devtools.js",
      "require": "./dist/devtools.cjs"
    },
    "./style.css": "./dist/vue-llm.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "vite build && vue-tsc -p tsconfig.build.json --emitDeclarationOnly",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "npm run build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test:vue2": "vitest run --config vitest.vue2.config.ts"
  },
  "peerDependencies": {
    "@mlc-ai/web-llm": ">=0.2.70",
    "@nuxt/kit": "^3.0.0 || ^4.0.0",
    "@vue/devtools-api": "^6.6.0 || ^7.0.0 || ^8.0.0",
    "vue": "^2.7.0 || ^3.3.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    },
    "@mlc-ai/web-llm": {
      "optional": true
    },
    "@vue/devtools-api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@lucide/vue": "^1.62.0",
    "@mlc-ai/web-llm": "^0.2.86",
    "@nuxt/kit": "^3.16.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/devtools-api": "^7.7.9",
    "@vue/test-utils": "^2.4.6",
    "clsx": "^2.1.1",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^25.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^7.3.7",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.7",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0",
    "vue2": "npm:vue@^2.7.16"
  }
}
